{
  "manifestVersion": 3,
  "env": {
    "VIRTUAL_ENV": ".venv",
    "PATH": "$(echo .venv/bin:$PATH)"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "check": {
      "name": "check",
      "description": "Run all static checks: lint, format check, type check",
      "steps": [
        {
          "spawn": "lint"
        },
        {
          "spawn": "format:check"
        },
        {
          "spawn": "typecheck"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile"
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "python",
            ".projenrc.py"
          ]
        }
      ]
    },
    "deploy": {
      "name": "deploy",
      "description": "Deploys your CDK app to the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "destroy": {
      "name": "destroy",
      "description": "Destroys your cdk app in the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "destroy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "diff": {
      "name": "diff",
      "description": "Diffs the currently deployed app against your code",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "diff"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "format": {
      "name": "format",
      "description": "Format code with ruff",
      "steps": [
        {
          "exec": "ruff format ."
        }
      ]
    },
    "format:check": {
      "name": "format:check",
      "description": "Verify ruff formatting",
      "steps": [
        {
          "exec": "ruff format --check ."
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install dependencies and update lockfile",
      "steps": [
        {
          "execArgs": [
            "uv",
            "sync"
          ]
        },
        {
          "execArgs": [
            "uv",
            "lock"
          ]
        },
        {
          "exec": "pre-commit install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install dependencies with frozen lockfile",
      "steps": [
        {
          "execArgs": [
            "uv",
            "sync"
          ]
        }
      ]
    },
    "lint": {
      "name": "lint",
      "description": "Lint with ruff",
      "steps": [
        {
          "exec": "ruff check ."
        }
      ]
    },
    "lint:fix": {
      "name": "lint:fix",
      "description": "Autofix ruff violations (safe fixes only)",
      "steps": [
        {
          "exec": "ruff check --fix ."
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "execArgs": [
            "uv",
            "build"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation",
      "steps": [
        {
          "spawn": "synth:silent"
        }
      ]
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "publish": {
      "name": "publish",
      "description": "Uploads the package to PyPI.",
      "steps": [
        {
          "execArgs": [
            "uv",
            "publish"
          ]
        }
      ]
    },
    "publish:test": {
      "name": "publish:test",
      "description": "Uploads the package against a test PyPI endpoint.",
      "steps": [
        {
          "execArgs": [
            "uv",
            "publish",
            "--index",
            "testpypi"
          ]
        }
      ]
    },
    "security": {
      "name": "security",
      "description": "Run all security scanners: dependency audit, secret history, source patterns, config misconfigurations, IaC policy",
      "steps": [
        {
          "spawn": "security:sca-python"
        },
        {
          "spawn": "security:sast"
        },
        {
          "spawn": "security:secret-scan"
        },
        {
          "spawn": "security:misconfig-scan"
        },
        {
          "spawn": "security:iac-scan"
        },
        {
          "spawn": "security:git-hub-actions-scan"
        },
        {
          "spawn": "security:sca-multi"
        },
        {
          "spawn": "security:dockerfile-lint"
        }
      ]
    },
    "security:dockerfile-lint": {
      "name": "security:dockerfile-lint",
      "description": "Lint Dockerfiles with Hadolint",
      "steps": [
        {
          "exec": "find . -name 'Dockerfile*' -not -path './.venv/*' -not -path '*/node_modules/*' -exec hadolint {} +"
        }
      ]
    },
    "security:git-hub-actions-scan": {
      "name": "security:git-hub-actions-scan",
      "description": "Static analysis of GitHub Actions workflows",
      "steps": [
        {
          "exec": "zizmor ."
        }
      ]
    },
    "security:iac-scan": {
      "name": "security:iac-scan",
      "description": "IaC policy scan of the synthesized CloudFormation template (cdk.out)",
      "steps": [
        {
          "exec": "uvx --isolated checkov@3.4.0 --config-file .checkov.yaml"
        }
      ]
    },
    "security:misconfig-scan": {
      "name": "security:misconfig-scan",
      "description": "Misconfiguration scan of the workspace (Dockerfile etc.)",
      "steps": [
        {
          "exec": "trivy fs --config trivy.yaml --exit-code 1 ."
        }
      ]
    },
    "security:sast": {
      "name": "security:sast",
      "description": "Static pattern scan of tracked sources (three rulesets)",
      "steps": [
        {
          "exec": "opengrep scan --verbose --config p/security-audit --config p/owasp-top-ten --config p/python ."
        }
      ]
    },
    "security:sca-multi": {
      "name": "security:sca-multi",
      "description": "Scan dependencies for known vulnerabilities (OSV)",
      "steps": [
        {
          "exec": "osv-scanner scan source --recursive ."
        }
      ]
    },
    "security:sca-python": {
      "name": "security:sca-python",
      "description": "Audit uv.lock for known vulnerabilities and deprecated projects",
      "steps": [
        {
          "exec": "uv audit --preview-features audit-command"
        }
      ]
    },
    "security:secret-scan": {
      "name": "security:secret-scan",
      "description": "Scan the full git history for leaked credentials",
      "steps": [
        {
          "exec": "gitleaks detect --no-banner --config .gitleaks.toml"
        }
      ]
    },
    "synth": {
      "name": "synth",
      "description": "Synthesizes your cdk app into cdk.out",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "synth"
          ]
        }
      ]
    },
    "synth:silent": {
      "name": "synth:silent",
      "description": "Synthesizes your cdk app into cdk.out and suppresses the template in stdout (part of \"yarn build\")",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "synth",
            "-q"
          ]
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "execArgs": [
            "pytest"
          ]
        }
      ]
    },
    "typecheck": {
      "name": "typecheck",
      "description": "Type check with ty",
      "steps": [
        {
          "exec": "ty check --error-on-warning ."
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watches changes in your source code and rebuilds and deploys to the current account",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy",
            "--hotswap"
          ]
        },
        {
          "execArgs": [
            "cdk",
            "watch"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.py and run \"npx projen\"."
}
